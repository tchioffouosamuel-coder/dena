# Base de données
DATABASE_URL="mysql://dena_user:changeme@localhost:3306/dena_db"

# JWT
JWT_SECRET="change_this_to_a_long_random_string"
JWT_EXPIRES_IN="8h"

# Serveur
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Média (stockage local par défaut ; passez à S3-compatible en prod, ex: Cloudflare R2)
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=./uploads
# Optionnel, si MEDIA_STORAGE=s3 (compatible Cloudflare R2 / AWS S3)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
